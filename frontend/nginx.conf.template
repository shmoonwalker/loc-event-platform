# Rendered at container start by the nginx image (envsubst), so ${BACKEND_URL} and
# ${NGINX_LOCAL_RESOLVERS} are filled in from the environment.
server {
  listen 3000;
  listen [::]:3000;
  root /usr/share/nginx/html;
  index index.html;

  # The browser calls /api on this origin; forward it to the backend service.
  # The upstream is a variable + resolver so nginx resolves it lazily: the container still starts if the
  # backend is briefly down, and picks up address changes (Railway private network, Docker service names).
  location /api/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend "${BACKEND_URL}";
    proxy_pass $backend;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 30s;
  }

  # Hashed build files never change: cache them hard. index.html must always be revalidated.
  location ~* \.(?:js|css|woff2?|svg|ico|png|jpg|webp)$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
