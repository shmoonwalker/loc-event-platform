<section class="wrap py-16">
  <h1 class="display text-[clamp(36px,5vw,60px)]">Log in</h1>
  <p class="mt-4 text-muted">
    No account yet? <a routerLink="/register" class="link">Sign up</a>
  </p>

  <form [formGroup]="form" (ngSubmit)="submit()" class="mt-8 flex max-w-md flex-col gap-5">
    <div class="flex flex-col gap-1.5">
      <label for="email" class="font-semibold">Email</label>
      <input
        id="email"
        formControlName="email"
        type="email"
        autocomplete="email"
        class="field-input"
        aria-describedby="email-error"
        [attr.aria-invalid]="errorFor('email') ? true : null"
      />
      <p id="email-error" class="text-sm text-danger">
        @if (errorFor('email'); as message) {
          {{ message }}
        }
      </p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="password" class="font-semibold">Password</label>
      <div class="relative">
        <input
          id="password"
          formControlName="password"
          [type]="showPassword() ? 'text' : 'password'"
          autocomplete="current-password"
          class="field-input w-full pr-16"
          aria-describedby="password-error"
          [attr.aria-invalid]="errorFor('password') ? true : null"
        />
        <button
          type="button"
          class="absolute inset-y-0 right-0 px-3 text-sm font-semibold text-muted hover:text-ink"
          (click)="showPassword.update((shown) => !shown)"
        >
          {{ showPassword() ? 'Hide' : 'Show' }}<span class="sr-only"> password</span>
        </button>
      </div>
      <p id="password-error" class="text-sm text-danger">
        @if (errorFor('password'); as message) {
          {{ message }}
        }
      </p>
    </div>

    @if (formError(); as message) {
      <p role="alert" class="text-sm text-danger">{{ message }}</p>
    }
    <button type="submit" class="btn-primary" [disabled]="sending()">
      {{ sending() ? 'Logging in…' : 'Log in' }}
    </button>
  </form>
</section>
