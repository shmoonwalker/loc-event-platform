# Template for docker-compose.prod.yml. Copy to .env.production (ignored by Git) and replace every
# <placeholder>. Unset required values make Compose stop with an error.

# Existing Docker network shared with PostgreSQL, RabbitMQ and Redis.
LOC_SHARED_NETWORK=<shared-network-name>

# PostgreSQL 18: one LOC database for both applications.
DB_HOST=<postgres-host-on-shared-network>
DB_PORT=5432
DB_NAME=<loc-database>
# Owns the app schema; reads the publication schema.
BACKEND_DB_USER=<backend-db-user>
BACKEND_DB_PASSWORD=<backend-db-password>
# Owns the catalog and publication schemas.
DATA_DB_USER=<data-db-user>
DATA_DB_PASSWORD=<data-db-password>

# RabbitMQ (data only), with a dedicated LOC virtual host.
RABBITMQ_HOST=<rabbitmq-host-on-shared-network>
RABBITMQ_PORT=5672
RABBITMQ_USER=<loc-rabbitmq-user>
RABBITMQ_PASSWORD=<loc-rabbitmq-password>
RABBITMQ_VHOST=<loc-vhost>

# Redis (backend rate limiting). Keys are prefixed with loc:.
REDIS_URL=redis://:<redis-password>@<redis-host-on-shared-network>:6379/0

# Account emails (backend) via Resend SMTP. The password is a Resend API key with
# Sending access, limited to the mail.loc.shadibuilds.dev domain.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<resend-api-key>
MAIL_FROM=Loc <no-reply@mail.loc.shadibuilds.dev>
# Base of the links in account emails.
FRONTEND_URL=https://loc.shadibuilds.dev

# Signs login access tokens (backend). Generate with: openssl rand -base64 32
JWT_SECRET=<base64-32-byte-secret>

# Cloudflare R2 raw payload storage (data).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=<r2-access-key-id>
R2_SECRET_KEY=<r2-secret-access-key>
R2_BUCKET=<r2-bucket>

# External APIs used by the data worker (names as the application reads them).
Ticketmaster=<ticketmaster-api-key>
GeminiAPIKey=<gemini-api-key>

# New Relic (EU) ingest license key: the OpenTelemetry agents in backend and data export traces and
# metrics to otlp.eu01.nr-data.net with it.
NEW_RELIC_LICENSE_KEY=<new-relic-license-key>

# Optional: memory limits and JVM options. Server memory is not verified; size these to the host.
# LOC_FRONTEND_MEM_LIMIT=128m
# LOC_BACKEND_MEM_LIMIT=768m
# LOC_DATA_MEM_LIMIT=768m
# LOC_BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=65
# LOC_DATA_JAVA_OPTS=-XX:MaxRAMPercentage=65
# Optional: true turns the OpenTelemetry agents off without a new release.
# LOC_OTEL_DISABLED=false
